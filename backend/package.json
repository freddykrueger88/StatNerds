{
  "name": "statnerds-backend",
  "version": "0.7.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start":  "node src/server.js",
    "dev":    "nodemon src/server.js",
    "test":   "jest --coverage",
    "lint":   "eslint src --ext .js"
  },
  "dependencies": {
    "axios":               "^1.6.0",
    "cors":                "^2.8.5",
    "dotenv":              "^16.4.5",
    "express":             "^4.18.3",
    "express-rate-limit":  "^7.2.0",
    "pg":                  "^8.11.5"
  },
  "devDependencies": {
    "eslint":   "^8.57.0",
    "jest":     "^29.7.0",
    "nodemon":  "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": { "functions": 50 }
    }
  }
}
