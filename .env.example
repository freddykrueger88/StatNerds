# ============================================================
# StatNerds – Umgebungsvariablen
# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env Datei wird niemals ins Git eingecheckt.
# ============================================================

# ── Datenbank ───────────────────────────────────────────────
DATABASE_URL=postgresql://statnerds:statnerds@db:5432/statnerds

# ── Server ────────────────────────────────────────────────
PORT=8000
NODE_ENV=production

# CORS: Komma-getrennte Liste erlaubter Origins
# Lokal: http://localhost:3000
# Produktion: https://deine-domain.de
ALLOWED_ORIGINS=http://localhost:3000

# ── Sicherheit ────────────────────────────────────────────
# Admin-Key für geschützte Endpunkte (z.B. DELETE /api/stats/cleanup)
# Generiere einen sicheren Zufallsstring: openssl rand -hex 32
ADMIN_API_KEY=ersetze-mich-mit-einem-sicheren-zufallsstring

# ── Optionale externe APIs ─────────────────────────────────
# Alle Keys sind OPTIONAL. Die App funktioniert ohne sie (nur OpenLigaDB).
# Keys können alternativ auch direkt im Frontend unter Einstellungen eingetragen
# werden – sie werden dann nur lokal im Browser gespeichert.

# API-Football (https://dashboard.api-football.com/register)
# Kostenlos: 100 Requests/Tag | Features: xG, Live-Stats, TV, Schiedsrichter
API_FOOTBALL_KEY=

# TheSportsDB Patreon-Key (https://www.thesportsdb.com/api.php)
# Optional: Free-Tier funktioniert ohne Key
THE_SPORTSDB_KEY=

# Football-Data.org (https://www.football-data.org/client/register)
# Kostenlos | Features: Internationale Ligen, Champions League
FOOTBALL_DATA_KEY=
